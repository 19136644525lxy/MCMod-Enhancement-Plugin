{
  "manifest_version": 3,
  "name": "MC百科增强 · MCMod Plus",
  "version": "0.2.0",
  "description": "为 MC百科 提供全站视觉重做、Cmd+K 全局搜索与结构化检索。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.mcmod.cn/*"
  ],
  "background": {
    "service_worker": "src/bg.js"
  },
  "action": {
    "default_title": "MC百科增强",
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.mcmod.cn/*",
        "https://search.mcmod.cn/*",
        "https://center.mcmod.cn/*"
      ],
      "run_at": "document_start",
      "js": [
        "src/content/boot-splash.js"
      ]
    },
    {
      "matches": [
        "https://www.mcmod.cn/*",
        "https://search.mcmod.cn/*",
        "https://bbs.mcmod.cn/*",
        "https://play.mcmod.cn/*",
        "https://center.mcmod.cn/*"
      ],
      "run_at": "document_end",
      "js": [
        "src/content/core/dom.js",
        "src/content/core/store.js",
        "src/content/core/selectors.js",
        "src/content/core/theme.js",
        "src/content/core/fetch-page.js",
        "src/content/core/page-chrome.js",
        "src/content/render/components.js",
        "src/content/extract/search.js",
        "src/content/extract/modlist.js",
        "src/content/extract/item.js",
        "src/content/extract/klass.js",
        "src/content/extract/modpack.js",
        "src/content/extract/modpack-detail.js",
        "src/content/extract/post.js",
        "src/content/extract/tools.js",
        "src/content/extract/category.js",
        "src/content/extract/home.js",
        "src/content/render/page-shell.js",
        "src/content/render/pages/search.js",
        "src/content/widgets/footprint.js",
        "src/content/widgets/background.js",
        "src/content/widgets/settings-panel.js",
        "src/content/render/pages/home.js",
        "src/content/render/pages/center.js",
        "src/content/render/pages/item.js",
        "src/content/render/pages/klass.js",
        "src/content/render/pages/modpack.js",
        "src/content/render/pages/category.js",
        "src/content/render/pages/post.js",
        "src/content/render/pages/tools.js",
        "src/content/widgets/command-palette.js",
        "src/content/router.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles/*",
        "styles/pages/*",
        "assets/*"
      ],
      "matches": [
        "https://*.mcmod.cn/*"
      ]
    }
  ]
}
